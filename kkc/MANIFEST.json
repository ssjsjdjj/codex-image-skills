  "workbenches": 1,
  "entries": [
    {
      "name": "白底透明图 V2",
      "id": "chutu-baidi-touming-v2",
      "version": "2.4.0",
      "purpose": "800×800 白底 JPG、透明 PNG；每款高清分层 PSD、独立蒙版；边缘检查与 PS 精修队列。",
      "destination": "kkc/skills/chutu-baidi-touming-v2"
    },
    {
      "name": "尺寸调整",
      "id": "chutu-chicun-tiaozheng",
      "version": "3.4.1（整批／逐张两版）",
      "purpose": "主图和场景图按用途裁切、多尺寸导出、分组预览确认、图片与对应 PSD 数据包交付。",
      "destination": "kkc/skills/chutu-chicun-tiaozheng"
    },
    {
      "name": "小图找大图／同名替换",
      "id": "replace-images-by-name",
      "version": "2026-11-02 交付版",
      "purpose": "按文件名用高清原图替换已选小图，检查重名、缺失、备份和替换结果。",
      "destination": "kkc/skills/replace-images-by-name"
    },
    {
      "name": "AI 商品差异检测",
      "id": "ai-product-image-diff",
      "version": "2026-11-10 更新版",
      "purpose": "实拍与 AI 图按商品细节逐图对照，编号放大展示差异，并按指定位置修复复核。",
      "destination": "kkc/skills/ai-product-image-diff"
    },
    {
      "name": "SKU 同款换色场景套版",
      "id": "ecom-color-scene-swap",
      "version": "2026-10-27 版",
      "purpose": "按款号、颜色选产品与场景图，调整裁切，替换卡片内商品及颜色文字。",
      "destination": "kkc/skills/ecom-color-scene-swap"
    },
    {
      "name": "商品视觉审稿",
      "id": "kocotree-visual-review",
      "version": "2026-11-02 精简版",
      "purpose": "初稿、返稿、终稿九项审核；追踪问题关闭，保留本地审核记录和已解决案例库。",
      "destination": "kkc/skills/kocotree-visual-review"
    },
    {
      "name": "指定商品选区 PSD",
      "id": "product-selection-psd",
      "version": "2026-11-03 版",
      "purpose": "在原图中选择指定商品，保留完整原图、独立商品层和可编辑蒙版。",
      "destination": "kkc/skills/product-selection-psd"
    },
    {
      "name": "详情页图片处理 Skill",
      "id": "visual-detail-image-processor",
      "version": "2026-11-04 本地更新版",
      "purpose": "从 PSD／PSB 母版生成可编辑详情长图，保留智能对象、文案和表格，按需导出 JPG 模块。",
      "destination": "kkc/skills/visual-detail-image-processor"
    },
    {
      "name": "电商服饰视频提示词",
      "id": "ecom-video-prompt",
      "version": "2026-11-09 更新版",
      "purpose": "基于模特参考图、商品卖点和动作撰写中文图生视频提示词；处理布料、光影和动作的 AI 感。",
      "destination": "kkc/skills/ecom-video-prompt"
    },
    {
      "name": "Lovart 服装场景图提示词",
      "id": "lovart-apparel-prompt",
      "version": "2026-11-10 更新版",
      "purpose": "结合实拍、服装细节和动作场景参考，生成主提示词与局部返修词，约束质感、Logo 和指定模特。",
      "destination": "kkc/skills/lovart-apparel-prompt"
    },
    {
      "name": "AI 案例取证／使用报告",
      "id": "ai-case-evidence",
      "version": "1.5.0",
      "purpose": "整理原始证据、产物、反馈、计时与人工复核，生成案例提交稿和固定模板使用报告。",
      "destination": "kkc/skills/ai-case-evidence"
    },
    {
      "name": "详情页套版工作台",
      "id": "detail-workbench",
      "version": "0.5.11（含 5 套母版）",
      "purpose": "Windows 图形界面导入商品资料、绑定图片与表格、预览排版，再调用 Photoshop 生成可编辑 PSB。",
      "destination": "kkc/workbenches/detail-workbench"
    }
  ],
